# ── Application DNA Environment Configuration ──

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://appdna:appdna_secret@localhost:5432/appdna
DATABASE_URL_SYNC=postgresql://appdna:appdna_secret@localhost:5432/appdna

# Neo4j
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=appdna_neo4j_secret

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000"]

# Probe Engine Settings
PROBE_MAX_CONCURRENCY=3
PROBE_DEFAULT_DELAY_MS=500
PROBE_DEFAULT_TIMEOUT_S=10
PROBE_MIN_SAMPLES=5
PROBE_MAX_SAMPLES=10
PROBE_MAX_REQUESTS_PER_RUN=50

# Similarity Engine
SIMILARITY_HIGH_THRESHOLD=85
SIMILARITY_MEDIUM_THRESHOLD=60
SIMILARITY_LOW_THRESHOLD=50
CONFIDENCE_MIN_THRESHOLD=70
CORROBORATION_MIN_CATEGORIES=2

# FAISS Index
FAISS_INDEX_PATH=./data/faiss_index.bin
VECTOR_DIMENSIONS=100

# Feature Flags
ENABLE_BROWSER_PROBES=true
ENABLE_PLAYWRIGHT=true
